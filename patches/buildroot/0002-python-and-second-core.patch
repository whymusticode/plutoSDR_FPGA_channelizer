diff --git a/board/pluto/S03cpu1 b/board/pluto/S03cpu1
new file mode 100755
index 00000000..ef0d4c60
--- /dev/null
+++ b/board/pluto/S03cpu1
@@ -0,0 +1,17 @@
+#!/bin/sh
+# U-Boot boots Linux with maxcpus=1 (its stored environment, which a firmware
+# update does not rewrite). CPU hotplug can still bring the second Cortex-A9
+# online, so do it here: the channel apps and the network stack each get a core.
+
+case "$1" in
+	start)
+		f=/sys/devices/system/cpu/cpu1/online
+		[ -w "$f" ] && echo 1 > "$f" && echo "CPU1 online"
+		;;
+	stop|restart|reload)
+		;;
+	*)
+		echo "Usage: $0 {start}"
+		exit 1
+esac
+exit 0
diff --git a/board/pluto/post-build.sh b/board/pluto/post-build.sh
