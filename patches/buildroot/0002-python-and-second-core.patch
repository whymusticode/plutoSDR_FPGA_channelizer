diff --git a/package/libffi/0004-tramp-declare-open_temp_exec_file.patch b/package/libffi/0004-tramp-declare-open_temp_exec_file.patch
new file mode 100644
index 00000000..4b7a37ef
--- /dev/null
+++ b/package/libffi/0004-tramp-declare-open_temp_exec_file.patch
@@ -0,0 +1,17 @@
+From: Pluto channelizer build <noreply@localhost>
+Subject: [PATCH] tramp: declare open_temp_exec_file
+
+tramp.c calls open_temp_exec_file(), defined in closures.c, without a
+prototype. GCC 14 and later reject implicit function declarations, so the
+host libffi needed by host Python fails to build on a current distribution.
+
+--- a/src/tramp.c
++++ b/src/tramp.c
+@@ -46,6 +46,7 @@
+ #include <fcntl.h>
+ #include <pthread.h>
+ #include <sys/mman.h>
++int open_temp_exec_file (void);
+ #include <tramp.h>
+ #ifdef __linux__
+ #include <linux/limits.h>
diff --git a/package/libiio/0001-python-fall-back-to-the-soname.patch b/package/libiio/0001-python-fall-back-to-the-soname.patch
new file mode 100644
index 00000000..e26e1bce
--- /dev/null
+++ b/package/libiio/0001-python-fall-back-to-the-soname.patch
@@ -0,0 +1,19 @@
+From: Pluto channelizer build <noreply@localhost>
+Subject: [PATCH] python: fall back to the soname when find_library fails
+
+ctypes.util.find_library() needs ldconfig, gcc or objdump to search with;
+on a minimal target such as the ADALM-Pluto it returns None, CDLL(None)
+then opens the running interpreter, and the first iio_* symbol lookup
+fails. Fall back to loading the library by its soname.
+
+--- a/bindings/python/iio.py
++++ b/bindings/python/iio.py
+@@ -224,7 +224,7 @@
+     # Non-windows, possibly Posix system
+     _iiolib = "iio"
+ 
+-_lib = _cdll(find_library(_iiolib), use_errno=True, use_last_error=True)
++_lib = _cdll(find_library(_iiolib) or "libiio.so.0", use_errno=True, use_last_error=True)
+ 
+ _get_backends_count = _lib.iio_get_backends_count
+ _get_backends_count.restype = c_uint
