diff --git a/package/m4/0001-gnulib-prefer-gnu-nodiscard-attribute.patch b/package/m4/0001-gnulib-prefer-gnu-nodiscard-attribute.patch
new file mode 100644
index 00000000..607d8364
--- /dev/null
+++ b/package/m4/0001-gnulib-prefer-gnu-nodiscard-attribute.patch
@@ -0,0 +1,24 @@
+From: Pluto channelizer build <noreply@localhost>
+Subject: [PATCH] gnulib: prefer GNU nodiscard spelling with modern GCC
+
+GCC defines __STDC_VERSION__ as C23 while compiling in gnu11 mode, but the
+C23 [[nodiscard]] spelling cannot appear between the inline storage specifier
+and return type used by this older gnulib snapshot. Prefer GCC's established
+warn_unused_result spelling, which is valid in those declarations.
+
+--- a/lib/config.hin
++++ b/lib/config.hin
+@@ -2585,9 +2585,9 @@
+ # define _GL_ATTRIBUTE_MALLOC
+ #endif
+ 
+-#if 201710L < __STDC_VERSION__
+-# define _GL_ATTRIBUTE_NODISCARD [[__nodiscard__]]
+-#elif _GL_HAS_ATTRIBUTE (warn_unused_result)
++#if _GL_HAS_ATTRIBUTE (warn_unused_result)
+ # define _GL_ATTRIBUTE_NODISCARD __attribute__ ((__warn_unused_result__))
++#elif 201710L < __STDC_VERSION__
++# define _GL_ATTRIBUTE_NODISCARD [[__nodiscard__]]
+ #else
+ # define _GL_ATTRIBUTE_NODISCARD
+ #endif
